<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>olaboutcode</Authors>
        <Version>1.0.0</Version>
        <PackageTags>blazor;anime.js;animation;animatable</PackageTags>
        <Description>Animatable bindings for BlazorAnime. Shares the BlazorAnime anime.js engine.</Description>
        <PackageId>BlazorAnime.Animatable</PackageId>
        <Copyright>olaboutcode</Copyright>
        <PackageReleaseNotes>createAnimatable for anime.js 4.5.0. Depends on BlazorAnime 1.0.0.</PackageReleaseNotes>
        <AssemblyName>BlazorAnime.Animatable</AssemblyName>
        <RootNamespace>BlazorAnime</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BlazorAnime.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\BlazorAnime\BlazorAnime.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    </ItemGroup>

</Project>
