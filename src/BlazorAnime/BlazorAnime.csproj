<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>olaboutcode</Authors>
        <Version>0.0.1</Version>
        <PackageTags>blazor animation with tag selection</PackageTags>
        <Description>Blazor animation for tag selection</Description>
        <PackageId>BlazorAnime</PackageId>
        <Copyright>olaboutcode</Copyright>
        <PackageReleaseNotes>Initial release</PackageReleaseNotes>
        <AssemblyName>BlazorAnime</AssemblyName>
        <RootNamespace>BlazorAnime</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.2"/>
    </ItemGroup>

</Project>
