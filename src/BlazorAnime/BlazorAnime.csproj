<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>olaboutcode</Authors>
        <Version>1.0.0-alpha</Version>
        <PackageTags>blazor;anime.js;animejs;animation;timeline;svg;easings</PackageTags>
        <Description>Typed Blazor bindings for anime.js v4.</Description>
        <PackageId>BlazorAnime</PackageId>
        <Copyright>olaboutcode</Copyright>
        <PackageReleaseNotes>First publish. Tracks anime.js 4.5.0.</PackageReleaseNotes>
        <AssemblyName>BlazorAnime</AssemblyName>
        <RootNamespace>BlazorAnime</RootNamespace>
        <DefaultItemExcludes>$(DefaultItemExcludes);anime/**</DefaultItemExcludes>
    </PropertyGroup>

    <ItemGroup>
        <Content Remove="anime/**" />
        <None Remove="anime/**" />
    </ItemGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BlazorAnime.Tests"/>
        <InternalsVisibleTo Include="BlazorAnime.Animatable"/>
        <InternalsVisibleTo Include="BlazorAnime.Draggable"/>
        <InternalsVisibleTo Include="BlazorAnime.Layout"/>
        <InternalsVisibleTo Include="BlazorAnime.Scope"/>
        <InternalsVisibleTo Include="BlazorAnime.Events"/>
        <InternalsVisibleTo Include="BlazorAnime.Waapi"/>
        <InternalsVisibleTo Include="BlazorAnime.Text"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    </ItemGroup>

</Project>
