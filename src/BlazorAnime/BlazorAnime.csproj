<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>olaboutcode</Authors>
        <Version>0.0.1</Version>
        <PackageTags>blazor;anime.js;animation</PackageTags>
        <Description>Typed Blazor bindings for anime.js v3.</Description>
        <PackageId>BlazorAnime</PackageId>
        <Copyright>olaboutcode</Copyright>
        <PackageReleaseNotes>Initial release</PackageReleaseNotes>
        <AssemblyName>BlazorAnime</AssemblyName>
        <RootNamespace>BlazorAnime</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0"/>
    </ItemGroup>

</Project>
