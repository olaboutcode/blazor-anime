<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Authors>olaboutcode</Authors>
        <Version>1.0.0</Version>
        <PackageTags>blazor;anime.js;animation</PackageTags>
        <Description>Typed Blazor bindings for anime.js v4.</Description>
        <PackageId>BlazorAnime</PackageId>
        <Copyright>olaboutcode</Copyright>
        <PackageReleaseNotes>First publish. Tracks anime.js 4.5.0. The unpublished v3 surface is not kept.</PackageReleaseNotes>
        <AssemblyName>BlazorAnime</AssemblyName>
        <RootNamespace>BlazorAnime</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <SupportedPlatform Include="browser"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BlazorAnime.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    </ItemGroup>

</Project>
