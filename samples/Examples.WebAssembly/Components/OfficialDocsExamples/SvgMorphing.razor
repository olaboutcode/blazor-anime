@implements IAsyncDisposable;
@inject IAnime Anime;

@code {
    private Animation? _animation;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animation ??= await Anime.Animate(
                Prop.Targets(".morphing-demo .polymorph"),
                Prop.Points([
                    Prop.Value([
                        "70 24 119.574 60.369 100.145 117.631 50.855 101.631 3.426 54.369",
                        "70 41 118.574 59.369 111.145 132.631 60.855 84.631 20.426 60.369"
                    ]),
                    Prop.Value("70 6 119.574 60.369 100.145 117.631 39.855 117.631 55.426 68.369"),
                    Prop.Value("70 57 136.574 54.369 89.145 100.631 28.855 132.631 38.426 64.369"),
                    Prop.Value("70 24 119.574 60.369 100.145 117.631 50.855 101.631 3.426 54.369")
                ]),
                Prop.Easing.EaseOutQuad,
                Prop.Duration(2000),
                Prop.Loop(true)
            );
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
        {
            await _animation.DisposeAsync();
        }
    }
}