@inject IAnime Anime;

<div class="demo-content animation-callbacks-demo">
    <p>Progress: @_progress</p>
    <div class="el large square" style="background-color: #00ffdd;"></div>
    <div class="el large square" style="background-color: hsl(44, 100%, 50%);"></div>
</div>

@code {
    [CascadingParameter(Name = "DemoPlaying")]
    public bool? Playing { get; set; }

    private bool? _playingApplied;

    private Animation? _animationA;
    private float _progress;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animationA ??= await Anime.Animate(props => props
                .Targets(".animation-callbacks-demo .el ")
                .TranslateX(270)
                .BackgroundColor("#FFA500")
                .BorderRadius("10%", "50%")
                .Delay(SetDelay)
                .Duration(500)
                .Alternate(true)
                .Ease(Easing.InOutCirc)
                .OnUpdate(OnUpdate)
                .Loop(2)
                .AutoPlay(DemoPlayback.ShouldAutoPlay(Playing))
            );
            _playingApplied = await DemoPlayback.Apply(_animationA, Playing, _playingApplied);
        }
    }

    public double SetDelay(int index, int targetsCount)
    {
        return index * 500;
    }

    public void OnUpdate(AnimationState state)
    {
        _progress = state.Progress;
        StateHasChanged();
    }

    protected override async Task OnParametersSetAsync()
    {
        _playingApplied = await DemoPlayback.Apply(_animationA, Playing, _playingApplied);
    }
}