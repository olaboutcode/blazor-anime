@inherits AnimatedComponent;

<div class="demo">
    <div class="demo-content animation-callbacks-demo">
        <p>Progress: @_progress</p>
        <div class="el a large square"></div>
        <div class="el b large square" style="background-color: red;"></div>
        <button
            style="background-color: lightblue; color: black;"
            @onclick="OnPlayButtonClicked">Play</button>
    </div>
</div>

@code {
    private Animation? _animationA;
    private Animation? _animationB;
    private float _progress;

    public void OnPlayButtonClicked()
    {
        _animationA?.Play();
        _animationB?.Play();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animationA ??= await CreateAnimationAsync(
                nameof(_animationA),
                Prop.Targets(".animation-callbacks-demo .el.a"),
                Prop.Create("translateX", 270),
                Prop.Create("backgroundColor", "#FFA500"),
                Prop.Delay(OnDelay),
                Prop.Duration(500),
                Prop.Direction.Alternate,
                Prop.Easing.EaseInOutCirc,
                Prop.AutoPlay(false),
                Prop.Update(OnUpdate)
            );
            _animationB ??= await CreateAnimationAsync(
                nameof(_animationB),
                Prop.Targets(".animation-callbacks-demo .el.b"),
                Prop.Create("translateY", 270),
                Prop.Create("borderRadius", "50%"),
                Prop.Delay(OnDelay),
                Prop.Duration(1000),
                Prop.Direction.Alternate,
                Prop.Easing.EaseOutInBounce,
                Prop.AutoPlay(false),
                Prop.Update(OnUpdate)
            );
        }
    }

    [JSInvokable]
    public double OnDelay(int index, int targetsCount)
    {
        return index * 100;
    }

    [JSInvokable]
    public override void OnUpdate(AnimationState state)
    {
        _progress = state.Progress;
        base.OnUpdate(state);
    }
}