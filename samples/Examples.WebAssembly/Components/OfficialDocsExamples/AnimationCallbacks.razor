@implements IAsyncDisposable;
@inject IAnime Anime;

<div class="demo">
    <div class="demo-content animation-callbacks-demo">
        <p>Animation Began: @(_animationBegun ? "TRUE" : "FALSE")</p>
        <p>Animation Complete: @(_animationComplete ? "TRUE" : "FALSE")</p>
        <p>Animation Loop Begun: @(_loopBegun ? "TRUE" : "FALSE")</p>
        <p>Animation Loop Complete: @(_loopComplete ? "TRUE" : "FALSE")</p>
        <p>Animation Change Begun: @(_changeBegun ? "TRUE" : "FALSE")</p>
        <p>Animation Change Complete: @(_changeComplete ? "TRUE" : "FALSE")</p>
        <p>Update Count: @_updateCount</p>
        <p>Progress: @_progress</p>
        <div class="el large square"></div>
    </div>
</div>

@code {
    private Animation? _animation;
    
    private bool _animationBegun;
    private bool _animationComplete;
    private bool _loopBegun;
    private bool _loopComplete;
    private bool _changeBegun;
    private bool _changeComplete;
    private int _updateCount;
    private float _progress;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animation ??= await Anime.Animate(
                Prop.Targets(".animation-callbacks-demo .el"),
                Prop.Create("translateX", 270),
                Prop.Delay(1000),
                Prop.Duration(500),
                Prop.Direction.Alternate,
                Prop.Easing.EaseInOutCirc,
                Prop.AutoPlay(true),
                Prop.Update(OnUpdate),
                Prop.Begin(OnBegin),
                Prop.Complete(OnComplete),
                Prop.LoopBegin(OnLoopBegin),
                Prop.LoopComplete(OnLoopComplete),
                Prop.ChangeBegin(OnChangeBegin),
                Prop.ChangeComplete(OnChangeComplete)
            );
        }
    }

    [JSInvokable]
    public void OnBegin(AnimationState state)
    {
        _animationBegun = true;
    }

    [JSInvokable]
    public void OnUpdate(AnimationState state)
    {
        _updateCount++;
        _progress = state.Progress;
        //StateHasChanged();
    }
    
    [JSInvokable]
    public void OnComplete(AnimationState state)
    {
        _animationComplete = true;
    }
    
    [JSInvokable]
    public void OnLoopBegin(AnimationState state)
    {
        _loopBegun = true;
    }
    
    [JSInvokable]
    public void OnLoopComplete(AnimationState state)
    {
        _loopComplete = true;
    }
    
    [JSInvokable]
    public void OnChangeBegin(AnimationState state)
    {
        _changeBegun = true;
    }
    
    [JSInvokable]
    public void OnChangeComplete(AnimationState state)
    {
        _changeComplete = true;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
        {
            await _animation.DisposeAsync();
        }
    }
}