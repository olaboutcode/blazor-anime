@inherits AnimatedComponent;

<div class="demo-content animation-callbacks-demo">
    <p>Progress: @_progress</p>
    <div class="el a large square" style="background-color: #00ffdd;"></div>
    <p>@(_progress)</p>
</div>

@code {
    private Animation? _animationA;
    private float _progress;
    private bool _completed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animationA ??= await CreateAnimationAsync(
                nameof(_animationA),
                props => props
                .Targets(".animation-callbacks-demo .el.a")
                .TranslateX(270)
                .BackgroundColor("#FFA500")
                .Delay(SetDelay)
                .Duration(500)
                .Direction(Direction.Alternate)
                .Easing(Easing.EaseInOutCirc)
                .Update(OnUpdate)
                .Complete(OnComplete)
                .Loop(true)
                .AutoPlay(true)
            );
        }
    }

    [JSInvokable]
    public double SetDelay(int index, int targetsCount)
    {
        return index * 500;
    }

    [JSInvokable]
    public override void OnUpdate(AnimationState state)
    {
        _progress = state.Progress;
        base.OnUpdate(state);
    }

    [JSInvokable]
    public override void OnComplete(AnimationState state)
    {
        _completed = state.Completed;
        base.OnComplete(state);
    }
}