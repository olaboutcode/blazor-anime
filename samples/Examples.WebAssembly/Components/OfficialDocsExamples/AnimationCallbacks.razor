@inherits AnimatedComponent;

<div class="demo">
    <div class="demo-content animation-callbacks-demo">
        <p>Progress: @_progress</p>
        <div class="el a large square"></div>
        <div class="el b large square" style="background-color: red;"></div>
        <button
            style="background-color: lightblue; color: black;"
            @onclick="OnPlayButtonClicked">Play</button>
    </div>
</div>

@code {
    private Animation? _animationA;
    private Animation? _animationB;
    private float _progress;

    public void OnPlayButtonClicked()
    {
        _animationA?.Play();
        _animationB?.Play();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animationA ??= await CreateAnimationAsync(
                nameof(_animationA),
                props => props
                .Targets(".animation-callbacks-demo .el.a")
                .TranslateX(270)
                .BackgroundColor("#FFA500")
                .Delay(SetDelay)
                .Duration(500)
                .Direction(Direction.Alternate)
                .Easing(Easing.EaseInOutCirc)
                .AutoPlay(false)
                .Update(OnUpdate)
            );
            _animationB ??= await CreateAnimationAsync(
                nameof(_animationB),
                props => props
                .Targets(".animation-callbacks-demo .el.b")
                .TranslateY(270)
                .BorderRadius("50%")
                .Delay(SetDelay)
                .Duration(1000)
                .Direction(Direction.Alternate)
                .Easing(Easing.EaseOutInBounce)
                .AutoPlay(false)
                .Update(OnUpdate)
            );
        }
    }

    [JSInvokable]
    public double SetDelay(int index, int targetsCount)
    {
        return index * 500;
    }

    [JSInvokable]
    public override void OnUpdate(AnimationState state)
    {
        _progress = state.Progress;
        base.OnUpdate(state);
    }
}