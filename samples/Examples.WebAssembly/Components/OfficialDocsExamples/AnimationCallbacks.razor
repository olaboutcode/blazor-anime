@implements IAsyncDisposable;
@inject IAnime Anime;

<h3>AnimationCallbacks</h3>

<h4>Animation Began: @(_animationBegun ? "TRUE" : "FALSE")</h4>
<h4>Animation Complete: @(_animationComplete ? "TRUE" : "FALSE")</h4>
<h4>Animation Loop Begun: @(_loopBegun ? "TRUE" : "FALSE")</h4>
<h4>Animation Loop Complete: @(_loopComplete ? "TRUE" : "FALSE")</h4>
<h4>Animation Change Begun: @(_changeBegun ? "TRUE" : "FALSE")</h4>
<h4>Animation Change Complete: @(_changeComplete ? "TRUE" : "FALSE")</h4>
<h4>Update Count: @_updateCount</h4>

@code {
    private Animation? _animation;
    
    private bool _animationBegun;
    private bool _animationComplete;
    private bool _loopBegun;
    private bool _loopComplete;
    private bool _changeBegun;
    private bool _changeComplete;
    private int _updateCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animation ??= await Anime.Animation([
                Prop.Targets(".motion-path-demo .el"),
                Prop.Create("translateX", 270),
                Prop.Delay(1000),
                Prop.Direction.Alternate,
                Prop.Loop(3),
                Prop.Easing.EaseInOutCirc,
                Prop.AutoPlay(true),
                Prop.Update(this, nameof(OnUpdate), OnUpdate),
                Prop.Begin(this, nameof(OnBegin), OnBegin),
                Prop.Complete(this, nameof(OnComplete), OnComplete),
                Prop.LoopBegin(this, nameof(OnLoopBegin), OnLoopBegin),
                Prop.LoopComplete(this, nameof(OnLoopComplete), OnLoopComplete),
                Prop.ChangeBegin(this, nameof(OnChangeBegin), OnChangeBegin),
                Prop.ChangeComplete(this, nameof(OnChangeComplete), OnChangeComplete),
            ]);
        }
    }

    [JSInvokable]
    public void OnBegin()
    {
        _animationBegun = true;
    }

    [JSInvokable]
    public void OnUpdate()
    {
        _updateCount++;
    }
    
    [JSInvokable]
    public void OnComplete()
    {
        _animationComplete = true;
    }
    
    [JSInvokable]
    public void OnLoopBegin()
    {
        _loopBegun = true;
    }
    
    [JSInvokable]
    public void OnLoopComplete()
    {
        _loopComplete = true;
    }
    
    [JSInvokable]
    public void OnChangeBegin()
    {
        _changeBegun = true;
    }
    
    [JSInvokable]
    public void OnChangeComplete()
    {
        _changeComplete = true;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
        {
            await _animation.DisposeAsync();
        }
    }
}