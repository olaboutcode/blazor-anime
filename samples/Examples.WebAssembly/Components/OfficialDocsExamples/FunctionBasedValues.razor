@implements IAsyncDisposable;
@inject IAnime Anime;

<div style="padding: 100px;">
    <div class="function-based-values-demo">
        <div class="line">
            <div class="small circle shadow"></div>
            <div data-x="170" class="small circle el" style=""></div>
        </div>
        <div class="line">
            <div class="small circle shadow"></div>
            <div data-x="80" class="small circle el" style=""></div>
        </div>
        <div class="line">
            <div class="small circle shadow"></div>
            <div data-x="270" class="small circle el" style=""></div>
        </div>
    </div>
</div>

@code {
    private Animation? _animation;
    private Random _rnd = new Random();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animation ??= await Anime.Animate(props => props
                .Targets(".function-based-values-demo .el")
                .TranslateX(OnTranslateX)
                .TranslateY(OnTranslateY)
                .Scale(OnScale)
                .Rotate(OnRotate)
                .Prop("borderRadius", OnBorderRadius)
                .Duration(OnDuration)
                .Delay(OnDelay)
                .Direction(Direction.Alternate)
                .Loop(true)
                .AutoPlay(true)
            );
        }
    }

    [JSInvokable]
    public double OnTranslateX(int index, int targetsCount) => index switch
    {
        0 => 170,
        1 => 80,
        2 => 270,
        _ => 0
    };

    [JSInvokable]
    public double OnTranslateY(int index, int targetsCount) => 50 + (-50 * index);

    [JSInvokable]
    public double OnScale(int index, int targetsCount) => (targetsCount - index) + .25;

    [JSInvokable]
    public double OnRotate(int index, int targetsCount) => _rnd.Next(-360, 360);

    [JSInvokable]
    public object OnBorderRadius(int index, int targetsCount) => new string[2]{"50%", _rnd.Next(10, 35)+"%"};

    [JSInvokable]
    public double OnDuration(int index, int targetsCount) => _rnd.Next(1200, 1800);

    [JSInvokable]
    public double OnDelay(int index, int targetsCount) => _rnd.Next(0, 400);

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
        {
            await _animation.DisposeAsync();
        }
    }
}