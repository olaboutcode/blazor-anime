@implements IAsyncDisposable;
@inject IAnime Anime;

<div style="padding: 100px;">
    <div class="function-based-values-demo">
        <div class="line">
            <div class="small circle shadow"></div>
            <div data-x="170" class="small circle el" style=""></div>
        </div>
        <div class="line">
            <div class="small circle shadow"></div>
            <div data-x="80" class="small circle el" style=""></div>
        </div>
        <div class="line">
            <div class="small circle shadow"></div>
            <div data-x="270" class="small circle el" style=""></div>
        </div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "DemoPlaying")]
    public bool? Playing { get; set; }

    private bool? _playingApplied;

    private Animation? _animation;
    private Random _rnd = new Random();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animation ??= await Anime.Animate(props => props
                .Targets(".function-based-values-demo .el")
                .TranslateX(TranslationXSetter)
                .TranslateY(TranslationYSetter)
                .Scale(ScaleSetter)
                .Rotate(RotationSetter)
                .Prop("borderRadius", BorderRadiusSetter)
                .Duration(DurationSetter)
                .Delay(DelaySetter)
                .Direction(Direction.Alternate)
                .Loop(true)
                .AutoPlay(DemoPlayback.ShouldAutoPlay(Playing))
            );
            _playingApplied = await DemoPlayback.Apply(_animation, Playing, _playingApplied);
        }
    }

    public double TranslationXSetter(TargetInfo target) =>
        double.Parse(target.Dataset.GetValueOrDefault("x", "0"));

    public double TranslationYSetter(int index, int count) =>
        50 + (-50 * index);

    public double ScaleSetter(int index, int count) =>
        (count - index) + .25;

    public double RotationSetter(int index, int count) =>
        _rnd.Next(-360, 360);

    public object BorderRadiusSetter(int index, int count) =>
        new string[2]{"50%", _rnd.Next(10, 35)+"%"};

    public double DurationSetter(int index, int count) =>
        _rnd.Next(1200, 1800);

    public double DelaySetter(int index, int count) =>
        _rnd.Next(0, 400);

    
    protected override async Task OnParametersSetAsync()
    {
        _playingApplied = await DemoPlayback.Apply(_animation, Playing, _playingApplied);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
        {
            await _animation.DisposeAsync();
        }
    }
}