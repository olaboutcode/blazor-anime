@code {
    private Animation? _animation;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animation ??= await Anime.Animation([
                Prop.Targets(".staggering-grid-demo .el"),
                Prop.AutoPlay(true),
                Prop.Loop(3),
                Prop.Create("scale", [
                    [
                        Prop.Value(.1),
                        Prop.Easing.EaseOutSine,
                        Prop.Duration(500)
                    ],
                    [
                        Prop.Value(1),
                        Prop.Easing.EaseInOutQuad,
                        Prop.Duration(1200)
                    ]
                ]),
                Prop.Delay(Stagger.Create(200, [
                    StaggerProp.Grid(14, 5),
                    StaggerProp.From.Center
                ]))
            ]);
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
        {
            await _animation.DisposeAsync();
        }
    }
}