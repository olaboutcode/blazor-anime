@code {
    private Animation? _animation;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animation ??= await Anime.Animate(
                Prop.Targets(".staggering-axis-grid-demo .el"),
                Prop.AutoPlay(true),
                Prop.Loop(3),
                Prop.Create("translateX", Stagger.Create(10, [
                    StaggerProp.Grid(14, 5),
                    StaggerProp.From.Center,
                    StaggerProp.Axis.X
                ])),
                Prop.Create("translateY", Stagger.Create(10, [
                    StaggerProp.Grid(14, 5),
                    StaggerProp.From.Center,
                    StaggerProp.Axis.Y
                ])),
                Prop.Create("rotateZ", Stagger.Create(0, 90, [
                    StaggerProp.Grid(14, 5),
                    StaggerProp.From.Center,
                    StaggerProp.Axis.X
                ])),
                Prop.Delay(Stagger.Create(200, [
                    StaggerProp.Grid(14, 5),
                    StaggerProp.From.Center
                ])),
                Prop.Easing.EaseInOutQuad
            );
        }
    } 
    
    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
        {
            await _animation.DisposeAsync();
        }
    }
}