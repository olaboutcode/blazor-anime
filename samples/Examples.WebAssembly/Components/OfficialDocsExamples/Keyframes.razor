@implements IAsyncDisposable;
@inject IAnime Anime;

<div class="demo-content" style="padding: 100px;">
    <div class="animation-keyframes-demo">
        <div class="circle shadow"></div>
        <div class="circle el" style="background-color: green"></div>
    </div>
</div>

@code {
    private Animation? _keyframeAnimation;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _keyframeAnimation ??= await Anime.Animate(
                props => props
                .Targets(".animation-keyframes-demo .el")
                .Keyframes([
                    kf => kf.TranslateY(-40),
                    kf => kf.TranslateX(250),
                    kf => kf.TranslateY(40),
                    kf => kf.TranslateX(0),
                    kf => kf.TranslateY(0)
                ])
                .Duration(4000)
                .Easing(Easing.EaseOutElastic(1, .8))
                .Loop(true)
                .AutoPlay(true)
            );
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_keyframeAnimation is not null)
        {
            await _keyframeAnimation.DisposeAsync();
        }
    }
}