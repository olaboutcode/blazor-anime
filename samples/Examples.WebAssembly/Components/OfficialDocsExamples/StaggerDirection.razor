@implements IAsyncDisposable;
@inject IAnime Anime;

<div class="demo-content staggering-direction-demo">
    <div class="line">
        <div class="small square shadow"></div>
        <div class="small square el" style="background-color: green"></div>
    </div>
    <div class="line">
        <div class="small square shadow"></div>
        <div class="small square el" style="background-color: green"></div>
    </div>
    <div class="line">
        <div class="small square shadow"></div>
        <div class="small square el" style="background-color: green"></div>
    </div>
    <div class="line">
        <div class="small square shadow"></div>
        <div class="small square el" style="background-color: green"></div>
    </div>
    <div class="line">
        <div class="small square shadow"></div>
        <div class="small square el" style="background-color: green"></div>
    </div>
    <div class="line">
        <div class="small square shadow"></div>
        <div class="small square el" style="background-color: green"></div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "DemoPlaying")]
    public bool? Playing { get; set; }

    private bool? _playingApplied;

    private Animation? _animation;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animation ??= await Anime.Animate(
                props => props
                .Targets(".staggering-direction-demo .el")
                .TranslateX(300)
                .Delay(Stagger.Create(300, stg => stg
                    .Direction(Direction.Reverse)
                    .Easing(Easing.EaseOutQuad)))
                .Duration(1000)
                .Loop(true)
                .AutoPlay(DemoPlayback.ShouldAutoPlay(Playing))
            );
            _playingApplied = await DemoPlayback.Apply(_animation, Playing, _playingApplied);
        }
    }
    
    
    protected override async Task OnParametersSetAsync()
    {
        _playingApplied = await DemoPlayback.Apply(_animation, Playing, _playingApplied);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
        {
            await _animation.DisposeAsync();
        }
    }
}