@code {
    [CascadingParameter(Name = "DemoPlaying")]
    public bool? Playing { get; set; }

    private bool? _playingApplied;

    private Animation? _animation = null;
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animation ??= await Anime.Animate(
                props => props
                .Targets(".staggering-axis-grid-demo .el")
                .TranslateX(Stagger.Create(10, stg => stg
                    .Grid(14,5)
                    .From(StaggerPosition.Center)
                    .Axis(StaggerAxis.X)))
                .TranslateY(Stagger.Create(10, stg => stg
                    .Grid(14,5)
                    .From(StaggerPosition.Center)
                    .Axis(StaggerAxis.Y)))
                .RotateZ(Stagger.Create(0, 90, stg => stg
                    .Grid(14,5)
                    .From(StaggerPosition.Center)
                    .Axis(StaggerAxis.X)))
                .Delay(Stagger.Create(200, stg => stg
                    .Grid(14,5)
                    .From(StaggerPosition.Center)))
                .Easing(Easing.EaseInOutQuad)
                .Loop(3)
                .AutoPlay(DemoPlayback.ShouldAutoPlay(Playing))
            );
            _playingApplied = await DemoPlayback.Apply(_animation, Playing, _playingApplied);
        }
    } 
    
    
    protected override async Task OnParametersSetAsync()
    {
        _playingApplied = await DemoPlayback.Apply(_animation, Playing, _playingApplied);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
        {
            await _animation.DisposeAsync();
        }
    }
}