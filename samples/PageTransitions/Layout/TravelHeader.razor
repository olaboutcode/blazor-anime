@inject IAnime Anime
@inject TravelState Trip

<header class="@Page">
    <div class="bk-img">
        <div class="header-img header-index"></div>
        <div class="header-img header-place"></div>
        <div class="header-img header-group"></div>
    </div>

    <div class="nav-wrapper">
        <nav>
            <ul>
                <li><NavLink href="" Match="NavLinkMatch.All">@Trip.Selected.FirstName's Home</NavLink></li>
                <li><NavLink href="place">@Trip.Selected.FirstName's Places</NavLink></li>
                <li><NavLink href="group">@Trip.Selected.FirstName's Group Trips</NavLink></li>
            </ul>

            <button class="menu" type="button" @onclick="ToggleMenu" aria-label="Open menu">
                <svg viewBox="0 0 24 24" width="28" height="28">
                    <circle class="menu-dot first" cx="3" cy="12" r="3" />
                    <circle class="menu-dot middle" cx="12" cy="12" r="3" />
                    <circle class="menu-dot last" cx="21" cy="12" r="3" />
                </svg>
            </button>

            @if (Trip.MenuOpen)
            {
                <div class="menudrawer">
                    <NavLink href="" Match="NavLinkMatch.All">@Trip.Selected.FirstName's Home</NavLink>
                    <NavLink href="place">@Trip.Selected.FirstName's Places</NavLink>
                    <NavLink href="group">@Trip.Selected.FirstName's Group Trips</NavLink>
                </div>
            }

            @for (var index = 0; index < Trip.Users.Count; index++)
            {
                var captured = index;
                var traveler = Trip.Users[index];
                var selected = captured == Trip.IndexedUser;
                <button type="button"
                        class="profile @(selected ? "profile-photo" : "profile-photo-secondary") profile-@captured"
                        style="@ProfileStyle(captured)"
                        @onclick="() => Select(captured)">
                    <span class="online"></span>
                    <img src="@traveler.Image" alt="@traveler.Name" />
                </button>
            }

            <button type="button" class="follow @(Trip.Following ? "active-follow" : null)" @onclick="Trip.ToggleFollow">
                @(Trip.Following ? "✓ Following" : "Follow")
            </button>

            <h2 class="profile-name">
                @(Page == "group" ? Trip.Selected.Trips[0] : Trip.Selected.Name)
            </h2>

            <button type="button" class="side-icon" @onclick="ToggleSaved" aria-label="Save this trip">
                @if (Page == "index")
                {
                    <svg viewBox="0 0 24 24" width="22" height="22" class="mail">
                        <path d="M2 5h20v14H2z" fill="none" stroke="white" stroke-width="2" />
                        <path d="M2 6l10 8 10-8" fill="none" stroke="white" stroke-width="2" />
                    </svg>
                }
                else
                {
                    <svg class="plus" viewBox="0 0 24 24" width="18" height="18">
                        <line class="line1" x1="0" x2="24" y1="12" y2="12" stroke="#333" stroke-linecap="round" stroke-width="3" />
                        <line class="line2" x1="12" x2="12" y1="0" y2="24" stroke="#333" stroke-linecap="round" stroke-width="3" />
                    </svg>
                }
            </button>
            <div class="saveinfo">Saved!</div>

            <aside class="traveler-meta">
                <p class="map-pin">United States</p>
                <p class="calendar">@Trip.Selected.Days days traveling</p>
            </aside>

            @if (Page == "index")
            {
                <div class="stats">
                    <p class="bio">@Trip.Selected.Bio</p>
                    <div><span class="desc">Followers</span><br /><span class="lg">@Trip.Selected.Followers</span></div>
                    <div><span class="desc">Following</span><br /><span class="lg">@Trip.Selected.Following</span></div>
                </div>
            }
        </nav>
    </div>
</header>

@code {
    [Parameter, EditorRequired]
    public string Page { get; set; } = "index";

    private string? _shown;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _shown = Page;
            await ShowHeader(Page);
            return;
        }

        if (_shown == Page)
            return;

        var previous = _shown;
        _shown = Page;
        if (previous is not null)
            await Crossfade(previous, Page);
    }

    private async Task ShowHeader(string page)
    {
        foreach (var name in new[] { "index", "place", "group" })
        {
            await Anime.Set(
                [$".header-{name}"],
                props => name == page ? props.Opacity(1).Scale(1) : props.Opacity(0).Scale(1.1));
        }
    }

    private async Task Crossfade(string previous, string next)
    {
        await Anime.Set([$".header-{next}"], props => props.Opacity(0).Scale(1.1));
        var leave = Anime.Animate(props => props
            .Targets($".header-{previous}")
            .Opacity(0)
            .Scale(1.1)
            .Duration(400)
            .Ease(Easing.OutSine));
        var enter = Anime.Animate(props => props
            .Targets($".header-{next}")
            .Opacity(1)
            .Scale(1)
            .Duration(400)
            .Ease(Easing.OutSine));
        var animations = await Task.WhenAll(leave, enter);
        await Task.WhenAll(animations.Select(animation => animation.Finished()));
        foreach (var animation in animations)
            await animation.DisposeAsync();
    }

    private async Task ToggleMenu()
    {
        Trip.ToggleMenu();
        var opening = Trip.MenuOpen;
        var timeline = await Anime.CreateTimeline(props => props.AutoPlay(false).Ease(opening ? Easing.OutSine : Easing.InSine));
        await timeline.AddAsync(props => props
            .Targets(".menu-dot.first")
            .TranslateX(opening ? 18 : 0)
            .Duration(200), 0);
        await timeline.AddAsync(props => props
            .Targets(".menu-dot.last")
            .TranslateX(opening ? -18 : 0)
            .Duration(200), 0);
        await timeline.AddAsync(props => props
            .Targets(".menu-dot")
            .Prop("fill", opening ? "#7eebe6" : "#fff")
            .Duration(200)
            .Delay(Stagger.Create(40)), 0);
        await timeline.Play();
        await timeline.Finished();
        await timeline.DisposeAsync();
    }

    private async Task ToggleSaved()
    {
        if (Page == "index")
            return;

        var saving = !Trip.Saved;
        Trip.ToggleSaved();
        var timeline = await Anime.CreateTimeline(props => props.AutoPlay(false));
        await timeline.AddAsync(props => props
            .Targets(".plus")
            .Rotate(saving ? -360 : 0)
            .Duration(750)
            .Ease(Easing.OutExpo), 0);
        await timeline.AddAsync(props => saving
            ? props.Targets(".line2").Prop("x1", 6).Prop("y1", 12).Prop("x2", 11).Prop("y2", 17).Duration(700).Ease(Easing.OutExpo)
            : props.Targets(".line2").Prop("x1", 12).Prop("y1", 0).Prop("x2", 12).Prop("y2", 24).Duration(700).Ease(Easing.OutExpo), 0);
        await timeline.AddAsync(props => saving
            ? props.Targets(".line1").Prop("x1", 11).Prop("y1", 17).Prop("x2", 20).Prop("y2", 7).Duration(700).Ease(Easing.OutExpo)
            : props.Targets(".line1").Prop("x1", 0).Prop("y1", 12).Prop("x2", 24).Prop("y2", 12).Duration(700).Ease(Easing.OutBack), 0);
        if (saving)
        {
            await timeline.AddAsync(props => props
                .Targets(".saveinfo")
                .Opacity(0, 1)
                .Duration(500)
                .Ease(Easing.OutSine), 0);
            await timeline.AddAsync(props => props
                .Targets(".saveinfo")
                .Opacity(0)
                .Duration(400)
                .Ease(Easing.InExpo), 1000);
        }

        await timeline.Play();
        await timeline.Finished();
        await timeline.DisposeAsync();
    }

    private void Select(int index) => Trip.SelectUser(index);

    private string? ProfileStyle(int index)
    {
        // The original moves the first avatar into the selected person's slot.
        // The selected avatar itself is placed in the first slot by CSS.
        if (Page != "group" || index != 0)
            return null;

        var x = -70 + (Trip.IndexedUser * 55);
        return $"transform: translate3d({x}px, -70px, 0) scale(0.25)";
    }
}
