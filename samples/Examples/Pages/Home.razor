@page "/"
@page "/{Slug}"

<PageTitle>@(Entry?.Title ?? "Examples") · Blazor.Anime</PageTitle>

<DocsShell Slug="@Slug" />

@code {
    [Parameter]
    public string? Slug { get; set; }

    private DemoEntry? Entry => string.IsNullOrWhiteSpace(Slug)
        ? DemoCatalog.Default
        : DemoCatalog.Find(Slug);
}
