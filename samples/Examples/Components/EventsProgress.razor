@inherits EventsDemo

<div class="demo events-demo events-progress">
    <div class="events-scroll" @ref="_container">
        <div class="events-section"><span>scroll</span></div>
        <div class="events-section"><div class="square"></div></div>
        <div class="events-section"></div>
    </div>
</div>

@code {
    private ElementReference _container;

    protected override async Task Start()
    {
        var scroll = await Open(props => props
            .Container(_container)
            .Sync(true));
        await Animate(props => props
            .Targets(".events-progress .square")
            .TranslateX("4rem")
            .Duration(1000)
            .AutoPlay(scroll.Handle));
    }
}
