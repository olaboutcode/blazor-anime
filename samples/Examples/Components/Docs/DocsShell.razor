@inject IJSRuntime Js
@inject NavigationManager Navigation

<div class="docs-shell" data-docs-section="@Section?.Id">
    <header class="docs-header">
        <div class="docs-brand">
            <button type="button" class="docs-menu" @onclick="() => _navOpen = !_navOpen">Menu</button>
            <a href="@DemoCatalog.Default.Slug" class="docs-brand-link">
                <span class="docs-logo">blazor<span class="docs-logo-dot">.</span>anime</span>
                <span class="docs-version">4.5.0</span>
            </a>
        </div>
        <div class="docs-toolbar">
            <span class="docs-toolbar-title">@(Section?.Title ?? "Docs")</span>
            <label class="docs-search-label">
                <span class="docs-sr">Search</span>
                <input class="docs-search"
                       placeholder="Search"
                       value="@_query"
                       @oninput="OnSearch" />
            </label>
            <button type="button" class="docs-step" title="Previous demo" disabled="@(_previous is null)" @onclick="() => Go(_previous)">↑</button>
            <button type="button" class="docs-step" title="Next demo" disabled="@(_next is null)" @onclick="() => Go(_next)">↓</button>
        </div>
        <a class="docs-github" href="https://github.com/olaboutcode/blazor-anime">GitHub</a>
    </header>

    <div class="docs-body">
        @if (_navOpen)
        {
            <button type="button" class="docs-nav-backdrop" aria-label="Close menu" @onclick="() => _navOpen = false"></button>
        }
        <aside class="docs-sidebar @(_navOpen ? "is-open" : null)">
            <label class="docs-side-search">
                <span class="docs-sr">Search</span>
                <input placeholder="Search"
                       value="@_query"
                       @oninput="OnSearch" />
            </label>
            @if (!VisibleSections.Any())
            {
                <p class="docs-empty">No sections match.</p>
            }
            <nav class="docs-nav">
                <ul>
                    @foreach (var section in VisibleSections)
                    {
                        var sectionActive = SectionActive(section);
                        <li class="@(sectionActive ? "is-active" : null)" data-docs-section="@section.Id">
                            <a href="@section.Entries.First().Slug" @onclick="CloseNav">@section.Title</a>
                            @if (Searching || sectionActive)
                            {
                                <ul>
                                    @foreach (var group in section.Groups)
                                    {
                                        if (group.Title is null)
                                        {
                                            @foreach (var entry in group.Entries)
                                            {
                                                <li class="@(IsActive(entry) ? "is-active" : null)">
                                                    <a href="@entry.Slug" aria-current="@(IsActive(entry) ? "page" : null)" @onclick="CloseNav">@entry.Title</a>
                                                </li>
                                            }
                                        }
                                        else
                                        {
                                            var groupActive = GroupActive(group);
                                            <li class="@(groupActive ? "is-active" : null)">
                                                <a href="@group.Entries[0].Slug" @onclick="CloseNav">@group.Title</a>
                                                @if (Searching || groupActive)
                                                {
                                                    <ul>
                                                        @foreach (var entry in group.Entries)
                                                        {
                                                            <li class="@(IsActive(entry) ? "is-active" : null)">
                                                                <a href="@entry.Slug" aria-current="@(IsActive(entry) ? "page" : null)" @onclick="CloseNav">@entry.Title</a>
                                                            </li>
                                                        }
                                                    </ul>
                                                }
                                            </li>
                                        }
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            </nav>
            <a class="docs-side-github" href="https://github.com/olaboutcode/blazor-anime">GitHub</a>
        </aside>

        <div class="docs-demos">
            @foreach (var item in ActiveSectionEntries)
            {
                var active = IsActive(item);
                <article id="stage-@item.Slug"
                         class="docs-demo @(active ? "is-active" : null)"
                         tabindex="0"
                         @onclick="() => Select(item)"
                         @onkeydown="e => OnStageKey(e, item)">
                    <header class="docs-demo-header">
                        <h2>@item.Title</h2>
                    </header>
                    <div class="docs-demo-content" inert="@(!active)">
                        <div class="docs-demo-stage">
                            <CascadingValue Value="active" Name="DemoPlaying">
                                <DemoView Slug="@item.Slug" />
                            </CascadingValue>
                        </div>
                    </div>
                </article>
            }
        </div>

        <article class="docs-article">
            @if (Entry is null)
            {
                <h1>Not in this sample</h1>
                <p class="docs-details">That address is not one of the bundled examples.</p>
            }
            else
            {
                <h1>@Entry.Title</h1>
                <p class="docs-lead">@Entry.Summary</p>
                <p class="docs-details">@Entry.Details</p>

                <section class="code-preview">
                    <header>
                        <h2>@Entry.Title code example</h2>
                        <button type="button" class="code-preview-tab is-active" @onclick="CopyCode">@(_copied ? "Copied" : "C#")</button>
                    </header>
                    <pre><code>@Entry.Code</code></pre>
                </section>

                @if (Siblings.Count > 0)
                {
                    <div class="docs-section-links">
                        <h2>In this section</h2>
                        <ul>
                            @foreach (var sibling in Siblings)
                            {
                                <li><a href="@sibling.Slug">@sibling.Title</a></li>
                            }
                        </ul>
                    </div>
                }
            }
        </article>
    </div>
</div>

@code {
    [Parameter]
    public string? Slug { get; set; }

    private string _query = "";
    private bool _navOpen;
    private bool _copied;
    private string? _scrolledSlug;

    private bool Searching => !string.IsNullOrWhiteSpace(_query);

    private DemoEntry? Entry => string.IsNullOrWhiteSpace(Slug)
        ? DemoCatalog.Default
        : DemoCatalog.Find(Slug);

    private DemoSection? Section =>
        Entry is null
            ? null
            : DemoCatalog.Sections.First(section => section.Entries.Any(item => item.Slug == Entry.Slug));

    private IReadOnlyList<DemoEntry> ActiveSectionEntries =>
        Section is null ? [] : Section.Entries.ToList();

    private int ActiveIndex =>
        Entry is null ? -1 : ActiveSectionEntries.ToList().FindIndex(item => item.Slug == Entry.Slug);

    private DemoEntry? _previous => ActiveIndex > 0 ? ActiveSectionEntries[ActiveIndex - 1] : null;

    private DemoEntry? _next =>
        ActiveIndex >= 0 && ActiveIndex < ActiveSectionEntries.Count - 1
            ? ActiveSectionEntries[ActiveIndex + 1]
            : null;

    private IReadOnlyList<DemoEntry> Siblings =>
        Entry is null
            ? []
            : ActiveSectionEntries.Where(item => item.Slug != Entry.Slug).ToList();

    private IEnumerable<DemoSection> VisibleSections =>
        DemoCatalog.Sections
            .Select(section => section with
            {
                Groups = section.Groups
                    .Select(group => group with
                    {
                        Entries = group.Entries.Where(entry => Matches(section, group, entry)).ToList()
                    })
                    .Where(group => group.Entries.Count > 0)
                    .ToList()
            })
            .Where(section => section.Groups.Count > 0);

    protected override void OnParametersSet()
    {
        _copied = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Entry is null || _scrolledSlug == Entry.Slug)
            return;

        _scrolledSlug = Entry.Slug;
        await Js.InvokeVoidAsync("docsScrollTo", "stage-" + Entry.Slug);
    }

    private async Task Select(DemoEntry entry)
    {
        if (!IsActive(entry))
        {
            Go(entry);
            return;
        }

        await Js.InvokeVoidAsync("docsScrollTo", "stage-" + entry.Slug);
    }

    private void Go(DemoEntry? entry)
    {
        if (entry is null || IsActive(entry))
            return;

        _scrolledSlug = null;
        _navOpen = false;
        Navigation.NavigateTo(entry.Slug);
    }

    private async Task OnStageKey(KeyboardEventArgs args, DemoEntry entry)
    {
        if (args.Key is "Enter" or " ")
            await Select(entry);
    }

    private void OnSearch(ChangeEventArgs args) => _query = args.Value?.ToString() ?? "";

    private void CloseNav() => _navOpen = false;

    private bool Matches(DemoSection section, DemoGroup group, DemoEntry entry)
    {
        if (!Searching)
            return true;

        return section.Title.Contains(_query, StringComparison.OrdinalIgnoreCase)
            || (group.Title?.Contains(_query, StringComparison.OrdinalIgnoreCase) ?? false)
            || entry.Title.Contains(_query, StringComparison.OrdinalIgnoreCase)
            || entry.Summary.Contains(_query, StringComparison.OrdinalIgnoreCase);
    }

    private bool IsActive(DemoEntry entry) =>
        Entry is not null && string.Equals(Entry.Slug, entry.Slug, StringComparison.OrdinalIgnoreCase);

    private bool SectionActive(DemoSection section) =>
        Entry is not null && section.Entries.Any(entry => string.Equals(entry.Slug, Entry.Slug, StringComparison.OrdinalIgnoreCase));

    private bool GroupActive(DemoGroup group) =>
        Entry is not null && group.Entries.Any(entry => string.Equals(entry.Slug, Entry.Slug, StringComparison.OrdinalIgnoreCase));

    private async Task CopyCode()
    {
        if (Entry is null)
            return;

        await Js.InvokeVoidAsync("docsCopy", Entry.Code);
        _copied = true;
        await Task.Delay(1200);
        _copied = false;
    }
}
