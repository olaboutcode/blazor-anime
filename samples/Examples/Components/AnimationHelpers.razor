@inject IAnime Anime;

<div class="demo">
    <div class="demo-content helpers-demo">
        <p class="docs-note">@_note</p>
        <div class="small square el"></div>
    </div>
</div>

@code {
    private string _note = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var distance = await Anime.Random(40, 40);
        await Anime.Set(".helpers-demo .el", "translateX", distance);
        var current = await Anime.Get(".helpers-demo .el", "translateX");
        var version = await Anime.Version();
        var speed = await Anime.GetSpeed();
        _note = $"anime.js {version}, speed {speed}. translateX is {current}.";
        StateHasChanged();
    }
}
