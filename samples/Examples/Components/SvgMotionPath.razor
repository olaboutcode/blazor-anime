@implements IAsyncDisposable;
@inject IAnime Anime;

<div class="demo">
    <div class="demo-content motion-path-demo">
        <div class="motion-path">
            <div class="small square shadow follow-path"></div>
            <div class="small square el follow-path"></div>
            <svg width="256" height="112" viewBox="0 0 256 112">
                <path class="somePath" fill="none" stroke="currentColor" stroke-width="1" d="M8,56 C8,33.90861 25.90861,16 48,16 C70.09139,16 88,33.90861 88,56 C88,78.09139 105.90861,92 128,92 C150.09139,92 160,72 160,56 C160,40 148,24 128,24 C108,24 96,40 96,56 C96,72 105.90861,92 128,92 C154,93 168,78 168,56 C168,33.90861 185.90861,16 208,16 C230.09139,16 248,33.90861 248,56 C248,78.09139 230.09139,96 208,96 L48,96 C25.90861,96 8,78.09139 8,56 Z"></path>
            </svg>
        </div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "DemoPlaying")]
    public bool? Playing { get; set; }

    private bool? _playingApplied;
    private Animation? _animation;
    private MotionPath? _path;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var path = _path ??= await Anime.CreateMotionPath(".motion-path-demo path");

            _animation ??= await Anime.Animate(props => props
                .Targets(".motion-path-demo .el")
                .TranslateX(path.TranslateX)
                .TranslateY(path.TranslateY)
                .Rotate(path.Rotate)
                .Ease(Easing.Linear)
                .Duration(2000)
                .Loop(true)
                .AutoPlay(DemoPlayback.ShouldAutoPlay(Playing))
            );
            _playingApplied = await DemoPlayback.Apply(_animation, Playing, _playingApplied);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _playingApplied = await DemoPlayback.Apply(_animation, Playing, _playingApplied);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
            await _animation.DisposeAsync();
        if (_path is not null)
            await _path.DisposeAsync();
    }
}