@implements IAsyncDisposable;
@inject IAnime Anime;

<div style="padding: 100px;">
    <div class="demo-relative-values">
        <div class="circle shadow"></div>
        <div class="circle el relative-values" style="transform: translateX(100px);"></div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "DemoPlaying")]
    public bool? Playing { get; set; }

    private bool? _playingApplied;

    private Animation? _animation;
    private Random _rnd = new Random();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _animation ??= await Anime.Animate(props => props
                .Targets(".demo-relative-values .el")
                .TranslateX(kf => kf
                    .To(Relative.Multiply(2.5))
                    .Duration(1000))
                .Width(kf => kf
                    .To(Relative.Subtract(20))
                    .Duration(1800)
                    .Ease(Easing.InOutSine))
                .Rotate(kf => kf
                    .To(Relative.Add("2turn"))
                    .Duration(1800)
                    .Ease(Easing.InOutSine))
                .Alternate(true)
                .Loop(true)
                .AutoPlay(DemoPlayback.ShouldAutoPlay(Playing))
            );
            _playingApplied = await DemoPlayback.Apply(_animation, Playing, _playingApplied);
        }
    }

    
    protected override async Task OnParametersSetAsync()
    {
        _playingApplied = await DemoPlayback.Apply(_animation, Playing, _playingApplied);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_animation is not null)
        {
            await _animation.DisposeAsync();
        }
    }
}