@implements IAsyncDisposable;
@inject IAnime Anime;

<div class="demo">
    <div class="demo-content timeline-controls-demo">
        <div class="el square"></div>
    </div>
</div>

@code {
    [CascadingParameter(Name = "DemoPlaying")]
    public bool? Playing { get; set; }

    private bool? _playingApplied;

    private Timeline? _timeline;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _timeline ??= await Anime.CreateTimeline(
                props => props
                .Duration(750)
                .Ease(Easing.OutExpo)
                .AutoPlay(DemoPlayback.ShouldAutoPlay(Playing))
            )
            .AddAsync(
                props => props
                .Targets(".timeline-controls-demo .el.square")
                .TranslateX(250)
            );
            _playingApplied = await DemoPlayback.Apply(_timeline, Playing, _playingApplied);
        }
    }

    
    protected override async Task OnParametersSetAsync()
    {
        _playingApplied = await DemoPlayback.Apply(_timeline, Playing, _playingApplied);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_timeline is not null)
        {
            await _timeline.DisposeAsync();
        }
    }
}