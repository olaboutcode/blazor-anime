@inherits AnimatableDemo

<div class="demo animatable-modifier" @onpointermove="Move">
    <div class="animatable-pair">
        <div class="animatable-col">
            <div class="clock clock-1"></div>
            <span class="animatable-caption">snapped</span>
        </div>
        <div class="animatable-col">
            <div class="clock clock-2"></div>
            <span class="animatable-caption">inverted</span>
        </div>
    </div>
</div>

@code {
    private Animatable? _snapped;
    private Animatable? _inverted;
    private IJSObjectReference? _snappedTarget;
    private IJSObjectReference? _invertedTarget;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _snapped = await Create(".animatable-modifier .clock-1", props => props
            .Property("rotate", property => property.Unit("rad"))
            .ModifierSnap(Math.PI / 10)
            .Duration(0));
        _inverted = await Create(".animatable-modifier .clock-2", props => props
            .Property("rotate", property => property.Unit("rad"))
            .ModifierInvert()
            .Duration(0));
        _snappedTarget = (await _snapped.Targets())[0];
        _invertedTarget = (await _inverted.Targets())[0];
    }

    private async Task Move(PointerEventArgs pointer)
    {
        await Track(pointer, async next =>
        {
            if (_snapped is null || _inverted is null || _snappedTarget is null || _invertedTarget is null)
                return;
            await _snapped.Set("rotate", await Angle(_snappedTarget, next) + Math.PI / 2);
            await _inverted.Set("rotate", await Angle(_invertedTarget, next) + Math.PI / 2);
        });
    }
}
